<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/route_info_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_gravity="top|center_horizontal"
    android:layout_marginTop="130dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/route_info_panel_background"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:elevation="0dp"
    android:visibility="gone"> <!-- 초기에는 숨김 -->

    <ImageView
        android:id="@+id/iv_transport_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_walk_icon" /> <!-- 도보 아이콘 (초기값) -->

    <TextView
        android:id="@+id/tv_total_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="00분"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"/>

    <TextView
        android:id="@+id/tv_total_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="0.0km"
        android:textSize="16sp"
        android:textColor="@android:color/black"/>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/> <!-- Spacer -->

    <ImageView
        android:id="@+id/btn_cancel_route"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:clickable="true"
        android:focusable="true"
        android:tint="@android:color/darker_gray"/>

</LinearLayout>
